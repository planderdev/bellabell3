# Copy to .env for local development. Hosted environments (Vercel) use project environment variables.

# Signs inquiry form tokens, admin cookies and hashes IPs. At least 32 characters:
#   openssl rand -hex 32
APP_SECRET=

# PostgreSQL (Supabase session pooler) for business inquiries. Apply db/schema.sql first.
#   postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# Inquiry desk at /admin. Generate with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
