{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["icn1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30,
      "excludeFiles": "{public/assets/**,results/**,tools/**,db/**,*.md}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
